  create  table "lastfm_charts"."gold_gold"."dim_faixa__dbt_tmp"
  
  
    as
  
  (
    -- dimensão de faixas musicais
-- chave natural: (track_name, id_artista)

with faixas as (

    select distinct
        track_name
        ,title
        ,artist_name
        ,album_name
    from "lastfm_charts"."gold_silver"."stg_scrobbles"

)

select
    

md5(cast(f.track_name as text) || '|' || cast(art.id_artista as text))

 as id_faixa
    ,f.track_name
    ,f.title
    ,art.id_artista
    ,alb.id_album
from faixas as f
inner join "lastfm_charts"."gold_gold"."dim_artista" as art
    on f.artist_name = art.artist_name
left join "lastfm_charts"."gold_gold"."dim_album" as alb
    on  f.album_name   = alb.album_name
    and art.id_artista = alb.id_artista
  );
  
