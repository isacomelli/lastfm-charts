  create  table "lastfm_charts"."gold"."fact_scrobbles__dbt_tmp"
  
  
    as
  
  (
    -- tabela fato: cada linha é um scrobble (evento de escuta)
-- granularidade: 1 linha por scrobble
-- usa row_number() para garantir id_scrobble único mesmo se houver
-- timestamps repetidos para o mesmo usuário

with base as (

    select
        username
        ,track_name
        ,artist_name
        ,album_name
        ,timestamp_unix
        ,row_number() over (
            partition by username, timestamp_unix
            order by track_name
        ) as rn
    from "lastfm_charts"."gold"."stg_scrobbles"

),

-- mantém apenas o primeiro scrobble em caso de timestamp duplicado por usuário
dedup as (

    select * from base where rn = 1

)

select
    

md5(cast(usr.id_usuario as text) || '|' || cast(d.timestamp_unix as text))

 as id_scrobble
    ,usr.id_usuario
    ,fax.id_faixa
    ,art.id_artista
    ,alb.id_album
    ,d.timestamp_unix                                                  as id_tempo
    ,1::smallint                                                       as scrobbles
from dedup as d
inner join "lastfm_charts"."gold"."dim_usuario" as usr
    on d.username    = usr.username
inner join "lastfm_charts"."gold"."dim_artista" as art
    on d.artist_name = art.artist_name
left join "lastfm_charts"."gold"."dim_album" as alb
    on  d.album_name  = alb.album_name
    and art.id_artista = alb.id_artista
left join "lastfm_charts"."gold"."dim_faixa" as fax
    on  d.track_name  = fax.track_name
    and art.id_artista = fax.id_artista
  );
  
