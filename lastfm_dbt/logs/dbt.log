  create  table "lastfm_charts"."gold_gold"."dim_album__dbt_tmp"
  
  
    as
  
  (
    -- dimensão de álbuns
-- chave natural: (album_name, id_artista) — mesmo nome pode ter artistas diferentes

with albums as (

    select distinct
        album_name
        ,artist_name
    from "lastfm_charts"."gold_silver"."stg_scrobbles"

)

select
    

md5(cast(a.album_name as text) || '|' || cast(art.id_artista as text))

 as id_album
    ,a.album_name
    ,art.id_artista
from albums as a
inner join "lastfm_charts"."gold_gold"."dim_artista" as art
    on a.artist_name = art.artist_name
  );
  
